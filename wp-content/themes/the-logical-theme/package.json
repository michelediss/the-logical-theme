{
  "name": "the-logical-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:pot": "wp i18n make-pot . languages/the-logical-theme.pot --slug=the-logical-theme --domain=the-logical-theme --exclude=.agents,.artifacts,assets,cf7-forms",
    "i18n:po": "wp i18n update-po languages/the-logical-theme.pot languages",
    "i18n:mo": "wp i18n make-mo languages",
    "i18n:json": "wp i18n make-json languages languages --domain=the-logical-theme --pretty-print --no-purge --use-map=languages/script-translations-map.json",
    "i18n:build": "npm run i18n:pot && npm run i18n:po && npm run i18n:mo && npm run i18n:json",
    "skill:export-blocks": "php .agents/skills/figma-make-theme-sync/scripts/export-theme-blocks.php",
    "skill:export-tokens": "node .agents/skills/figma-make-theme-sync/scripts/export-theme-tokens.mjs",
    "skill:export-visual-qa": "node .agents/skills/figma-make-theme-sync/scripts/export-visual-qa-config.mjs",
    "skill:inspect-mcp-debug": "node .agents/skills/figma-make-theme-sync/scripts/inspect-figma-mcp-dump.mjs",
    "skill:render-mcp-debug-html": "node .agents/skills/figma-make-theme-sync/scripts/render-figma-mcp-dump-html.mjs",
    "skill:test-mcp-debug": "node --test .agents/skills/figma-make-theme-sync/tests/figma-mcp-dump-contract.test.mjs",
    "skill:test-visual-qa": "node --test .agents/skills/figma-make-theme-sync/tests/*.test.mjs",
    "visual-qa:figma": "node .agents/skills/figma-make-theme-sync/scripts/capture-figma-make-screenshots.mjs",
    "visual-qa:wp": "node .agents/skills/figma-make-theme-sync/scripts/capture-wp-screenshots.mjs",
    "visual-qa:lighthouse": "node .agents/skills/figma-make-theme-sync/scripts/run-lighthouse-audit.mjs",
    "visual-qa:report": "node .agents/skills/figma-make-theme-sync/scripts/prepare-visual-qa-report.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "swiper": "^11.2.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^12.8.2",
    "playwright": "^1.53.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3"
  }
}
